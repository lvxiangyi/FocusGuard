# FocusGuard API keys. Copy this file to `.env` (same folder), then paste keys.
# Encoding: UTF-8 without BOM. The filename must be exactly `.env`, not `.env.txt`.
#
# Parse-safe rules:
# - one KEY=value per line
# - no spaces around =
# - do not wrap the key in quotes
# - leave unused keys empty
# - do not put a comment on the same line as a key
#
# You only need the key for the model you pick in Preferences.
# Full steps: docs/api-keys.md

# Default. Covers Qwen, GLM, MiniMax, Gemini, and OpenRouter OpenAI/Claude ids.
OPENROUTER_API_KEY=

# Official OpenAI models (gpt-4o-mini, gpt-4o)
OPENAI_API_KEY=

# Official Claude models (claude-sonnet-4-5)
ANTHROPIC_API_KEY=

# Official DeepSeek vision model only
DEEPSEEK_API_KEY=

# Direct MiniMax client. The listed MiniMax model still uses OpenRouter.
MINIMAX_API_KEY=
